POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me-before-running
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=sqlite:///./sentinel.db
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:3000
STORAGE_ROOT=storage
MAX_UPLOAD_BYTES=10485760
AI_PROVIDER=local_hf
AI_MODEL_ID=Qwen/Qwen2.5-3B-Instruct
# Optional local OpenAI-compatible endpoint provided by vLLM, llama.cpp, or TGI.
# Leave empty to use Sentinel's deterministic data-analysis engine only.
AI_BASE_URL=
AI_REQUEST_TIMEOUT_SECONDS=45
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
EMAIL_FROM=
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_HOURLY_LIMIT=5
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
API_INTERNAL_URL=http://localhost:8000/api/v1
